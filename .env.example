APP_NAME="IT Asset & Inventory Management"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=akp_asset
DB_USERNAME=akp_asset
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# System Requisition: push notification browser (VAPID; buat dengan `php artisan webpush:vapid`) & Telegram tim IT
VAPID_SUBJECT="${APP_URL}"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# --- Portal AKPSatu (SSO) ---
# Daftarkan modul "asset" di Portal (Admin > Modul), salin rahasianya ke sini, lalu SSO_ENABLED=true.
SSO_ENABLED=false
SSO_ALLOW_LOCAL_LOGIN=true
PORTAL_URL=http://localhost:8000
PORTAL_APP_CODE=asset
PORTAL_SSO_SECRET=
PORTAL_MAX_SESSION_MINUTES=480

# --- HRIS (sumber data karyawan, REST baca-saja) ---
HRIS_API_URL=
HRIS_API_TOKEN=
# Token yang dipakai HRIS membaca aset karyawan (sama dengan SIMA_API_TOKEN di .env HRIS)
SIMA_API_TOKEN=
